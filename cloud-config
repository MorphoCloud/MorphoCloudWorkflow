#!/bin/bash
set +e

retry() {
  local max_attempt=3
  local attempt=0
  while [ $attempt -lt $max_attempt ]; do
    if "$@"; then
      return 0
    fi
    echo "Command failed: $@"
    attempt=$((attempt + 1))
    if [ $attempt -lt $max_attempt ]; then
      sleep 5
    fi
  done
  echo "All retries of command failed: $@"
  return 1
}

# Report a named, terminal failure and stop. Every step below is a precondition
# for the playbook, so letting one fail silently (this script runs under `set +e`
# and retry() only logs) just defers the symptom: ansible-playbook is invoked
# against a missing or half-built checkout and the workflow reports a generic
# timeout, or worse, a real-looking ansible task name.
#
# The status line MUST go to the console: the poller in .github/actions/
# setup-instance reads `openstack console log show`, not the exoSetup property
# (which it writes itself, after polling). A reason emitted anywhere else is
# invisible to the workflow.
fail() {
  sleep 1  # let any preceding console output flush
  echo '{"status":"error", "epoch": '$(date '+%s')'000, "reason": "'"$1"'"}' | tee --append /dev/console > /dev/kmsg || true
  exit 1
}

# The boothook already probed egress before the module phase. Re-check here so a
# network that dies *between* the module phase and this script is still named
# rather than surfacing as a stalled playbook.
curl -sS -o /dev/null --max-time 10 https://github.com > /dev/null 2>&1 \
  || curl -sS -o /dev/null --max-time 10 https://pypi.org > /dev/null 2>&1 \
  || fail "no outbound network at setup start: could not reach github.com or pypi.org. Recreating usually lands on a different compute host."

# {create-cluster-command}
if which apt-get > /dev/null 2>&1; then    # Debian-based platforms
  retry apt-get install -y python3-venv || fail "could not install python3-venv (apt-get)"
elif which yum > /dev/null 2>&1; then      # RHEL-based platforms
  retry yum install -y python3 || fail "could not install python3 (yum)"
fi
python3 -m venv /opt/ansible-venv || fail "could not create the ansible virtualenv at /opt/ansible-venv"
. /opt/ansible-venv/bin/activate || fail "could not activate the ansible virtualenv"
retry pip install --upgrade pip || fail "could not upgrade pip"
retry pip install ansible-core passlib || fail "could not install ansible-core and passlib"
retry pip install lxml || fail "could not install lxml (required by community.general.xml)"
retry pip install psutil || fail "could not install psutil (required by community.general.pids)"
retry ansible-galaxy collection install community.general || fail "could not install the community.general ansible collection"

rm -rf /opt/instance-config-mgt

# retry git clone \
#   --depth=1 \
#   --branch="{instance-config-mgt-repo-checkout}" \
#   "{instance-config-mgt-repo-url}" \
#   /opt/instance-config-mgt

retry git clone \
  "https://github.com/MorphoCloud/exosphere.git" \
  /opt/instance-config-mgt \
  || fail "could not clone MorphoCloud/exosphere"

exosphere_sha="bc6a7b534348120b8694ffd137f023be53c6f032" # morpho-cloud-portal-2026.06-ubuntu24-prep
(cd /opt/instance-config-mgt && git reset --hard $exosphere_sha) \
  || fail "could not check out exosphere commit $exosphere_sha"

# A clone that drops mid-transfer leaves a checkout that exists but is
# incomplete. Without this guard ansible-playbook starts, fails partway, and the
# poller extracts a genuine-looking `TASK [...]` name -- pointing whoever reads
# the issue at an ansible bug when the actual cause was a network drop.
[ -f /opt/instance-config-mgt/ansible/playbook.yml ] \
  || fail "the exosphere checkout is incomplete (ansible/playbook.yml is missing) -- the clone likely dropped mid-transfer"

ansible-playbook \
  -i /opt/instance-config-mgt/ansible/hosts \
  -e "{\"guac_enabled\":true,\"gui_enabled\":true,\"session_timeout_hrs\":{session-timeout-hrs},\"ansible_python_interpreter\":\"/opt/ansible-venv/bin/python\"}" \
  /opt/instance-config-mgt/ansible/playbook.yml
ANSIBLE_RETURN_CODE=$?
if [ $ANSIBLE_RETURN_CODE -eq 0 ]; then STATUS="complete"; else STATUS="error"; fi
# Slicer extensions that fail to install are non-fatal; the playbook records them
# in this file so the completion status line carries the list to the workflow as
# reliably as the status itself (no separate console line to scroll out of view).
# Collapse newlines and drop JSON-special chars so the status line stays valid
# JSON regardless of how many names (or what characters) the file contains.
FAILED_EXTENSIONS=$(cat /opt/instance-config-support/slicer_failed_extensions 2>/dev/null | tr '\n' ' ' | tr -d '"\\' || true)
sleep 1  # Ensures that console log output from any previous commands complete before the following command begins
echo '{"status":"'$STATUS'", "epoch": '$(date '+%s')'000, "failed_extensions": "'"$FAILED_EXTENSIONS"'"}' | tee --append /dev/console > /dev/kmsg || true


