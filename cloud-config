#!/bin/bash

# Ensure this hook only runs on the first boot.
if cloud-init-per instance exosphere-setup-starting /bin/false; then
  exit 0
fi

echo on > /proc/sys/kernel/printk_devkmsg || true  # Disable console rate limiting for distros that use kmsg
sleep 1  # Ensures that console log output from any previous command completes before the following command begins
echo '{"status":"starting", "epoch": '$(date '+%s')'000}' | tee --append /dev/console > /dev/kmsg || true
chmod 640 /var/log/cloud-init-output.log

# Bound every apt invocation on this instance, including cloud-init's own
# `package_update`/`package_upgrade`. Those run in package_update_upgrade_install,
# which is index 0 of cloud_final_modules -- 16 modules ahead of scripts_user --
# so they execute long before 90-exosphere-ansible-setup.sh gets a chance to set
# anything. Unbounded, an instance with no route off its subnet leaves apt
# retrying until well past the workflow's 1200s poll budget, and because the
# shell scripts never start, no status line is ever emitted and the run fails as
# a bare timeout with no cause. This file is written here because the boothook is
# the only hook that precedes the module phase.
cat > /etc/apt/apt.conf.d/99-morphocloud-acquire <<'MORPHOCLOUD_APT_CONF'
Acquire::http::Timeout "15";
Acquire::https::Timeout "15";
Acquire::ftp::Timeout "15";
Acquire::Retries "2";
MORPHOCLOUD_APT_CONF

# Fail fast, and by name, when the instance came up without a route off the
# tenant subnet. This failure mode is invisible to every cheaper check: DHCP,
# the metadata service and DNS (which resolves against the Neutron port on the
# subnet itself) all keep working, so the instance looks entirely healthy until
# something tries to leave the subnet. Probe what setup actually needs rather
# than the gateway. Boothooks run in the network stage -- the interface already
# holds its DHCP lease at this point -- so the probe is meaningful here; the
# retry window absorbs the last of the route programming rather than racing it.
morphocloud_have_egress() {
  curl -sS -o /dev/null --max-time 10 https://github.com > /dev/null 2>&1 && return 0
  curl -sS -o /dev/null --max-time 10 https://pypi.org > /dev/null 2>&1 && return 0
  return 1
}
morphocloud_egress_deadline=$((SECONDS + 60))
until morphocloud_have_egress; do
  if [ $SECONDS -ge $morphocloud_egress_deadline ]; then
    sleep 1
    echo '{"status":"error", "epoch": '$(date '+%s')'000, "reason": "no outbound network: the instance reached its own subnet (DHCP, metadata and DNS all answered) but could not reach github.com or pypi.org within 60s. Setup cannot proceed. This is per-instance, not per-image -- recreating schedules onto a different compute host and usually succeeds."}' | tee --append /dev/console > /dev/kmsg || true
    break
  fi
  sleep 5
done


