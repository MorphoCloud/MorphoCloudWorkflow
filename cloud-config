#!/bin/bash

# Ensure this hook only runs on the first boot.
if cloud-init-per instance exosphere-setup-starting /bin/false; then
  exit 0
fi

echo on > /proc/sys/kernel/printk_devkmsg || true  # Disable console rate limiting for distros that use kmsg
sleep 1  # Ensures that console log output from any previous command completes before the following command begins
echo '{"status":"starting", "epoch": '$(date '+%s')'000}' | tee --append /dev/console > /dev/kmsg || true
chmod 640 /var/log/cloud-init-output.log

# Bound every apt invocation on this instance, including cloud-init's own
# `package_update`/`package_upgrade`. Those run in package_update_upgrade_install,
# which is index 0 of cloud_final_modules -- 16 modules ahead of scripts_user --
# so they execute long before 90-exosphere-ansible-setup.sh gets a chance to set
# anything. Unbounded, an instance with no route off its subnet leaves apt
# retrying until well past the workflow's 1200s poll budget, and because the
# shell scripts never start, no status line is ever emitted and the run fails as
# a bare timeout with no cause. This file is written here because the boothook is
# the only hook that precedes the module phase.
cat > /etc/apt/apt.conf.d/99-morphocloud-acquire <<'MORPHOCLOUD_APT_CONF'
Acquire::http::Timeout "15";
Acquire::https::Timeout "15";
Acquire::ftp::Timeout "15";
Acquire::Retries "2";
MORPHOCLOUD_APT_CONF

# Detect -- but do not act on -- an instance that came up without a route off
# the tenant subnet. This failure mode is invisible to every cheaper check:
# DHCP, the metadata service and DNS (which resolves against the Neutron port on
# the subnet itself) all keep working, so the instance looks entirely healthy
# until something tries to leave the subnet. Probe what setup actually needs
# rather than the gateway. Boothooks run in the network stage, so the interface
# already holds its DHCP lease by now and the probe is meaningful here; the
# window absorbs the tail of route programming rather than racing it. The
# verdict belongs to 90-exosphere-ansible-setup.sh -- see below.
morphocloud_have_egress() {
  curl -s -o /dev/null --max-time 10 https://github.com > /dev/null 2>&1 && return 0
  curl -s -o /dev/null --max-time 10 https://pypi.org > /dev/null 2>&1 && return 0
  return 1
}
morphocloud_egress_deadline=$((SECONDS + 60))
until morphocloud_have_egress; do
  if [ $SECONDS -ge $morphocloud_egress_deadline ]; then
    # Deliberately do NOT emit a status line here. Two reasons:
    #
    #   - 00-exosphere-setup-running.sh runs unconditionally after this, and the
    #     poller keys on the *last* status line, so its {"status":"running"}
    #     would supersede an error emitted here anyway.
    #   - more importantly, if route programming merely finished late, a
    #     terminal error here would destroy an instance that was about to come
    #     up perfectly well. The poller acts on the first error it samples, so
    #     emitting one from a probe this early is a race against recovery.
    #
    # Instead collapse the apt allowance. The module phase is about to try every
    # remote source and would otherwise spend minutes discovering, one timeout
    # at a time, what this probe already knows -- and it is that delay, not the
    # missing status line, that made the old failure take 20 minutes. Getting
    # through it quickly hands the decision to the setup script's own probe,
    # which is the single authority on whether setup can proceed.
    cat > /etc/apt/apt.conf.d/99-morphocloud-acquire <<'MORPHOCLOUD_APT_DEGRADED'
Acquire::http::Timeout "3";
Acquire::https::Timeout "3";
Acquire::ftp::Timeout "3";
Acquire::Retries "0";
MORPHOCLOUD_APT_DEGRADED
    break
  fi
  sleep 5
done


